# --- Three.dev -----------------------------------------------------------------

# Three.dev API key (r3_sk_...). Sent as the x-three-api-key header on every request.
THREE_API_KEY=your-three-api-key-here

# three.dev gateway base URL, with no path. Default: https://gate.three.dev
# The per-provider base URLs are built from it (<gateway>/v1, or <gateway> itself for Anthropic,
# Gemini and Azure deployment URLs).
THREE_GATEWAY_URL=https://gate.three.dev

# Use case slug, sent as the x-three-use-case header. A new slug is created on its first
# request (up to 20 use cases per organization).
USE_CASE_SLUG=weather-assistant

# --- Providers -----------------------------------------------------------------
# Set the keys of the providers you want to run; providers without keys are skipped.
# The keys are your own provider keys: the gateway forwards them to the provider.

# OpenAI API key.
OPENAI_API_KEY=
# OpenAI model. Default: gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini

# Anthropic API key.
ANTHROPIC_API_KEY=
# Anthropic model. Default: claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Google Gemini API key (Google AI Studio).
GOOGLE_GENERATIVE_AI_API_KEY=
# Gemini model. Default: gemini-3.8-flash
GOOGLE_MODEL=gemini-3.8-flash

# OpenRouter API key.
OPENROUTER_API_KEY=
# OpenRouter model. Default: qwen/qwen3.8-27b
OPENROUTER_MODEL=qwen/qwen3.8-27b

# Azure OpenAI API key (the resource's key).
AZURE_API_KEY=
# Azure OpenAI resource address with no path, e.g. https://<resource>.openai.azure.com
AZURE_ENDPOINT=
# Azure deployment name. It is the model for every Azure call.
AZURE_DEPLOYMENT=
# Optional. Azure API version, e.g. 2025-04-01-preview: the value after api-version= in the
# deployment's Target URI, not the model version. Only used for the extra Chat Completions
# call on deployment URLs; leave empty to skip that call. A wrong value is answered by
# Azure with 404 Resource not found.
AZURE_API_VERSION=
